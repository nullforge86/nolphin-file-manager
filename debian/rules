#!/usr/bin/make -f

# Force UTF8 to workaround build error
export LC_ALL=C.UTF-8

include /usr/share/dpkg/architecture.mk

# Nolphin ist für Linux Mint gebaut. Die Cinnamon-Bibliothek heißt dort
# libcinnamon-desktop4 (6.6), bei Ubuntu libcinnamon-desktop4t64 (6.0).
# Ein gegen die Ubuntu-Bibliothek gebautes Paket ersetzt auf Mint die
# Cinnamon-Bibliothek und der Desktop startet nicht mehr. Deshalb nur mit
# den Mint-Paketen bauen (Ausnahme bewusst mit NOLPHIN_ALLOW_NON_MINT=1;
# so gebaute Pakete NICHT auf Linux Mint installieren).
ifneq (,$(shell dpkg-query -W -f='$${Status}' libcinnamon-desktop4t64 2>/dev/null | grep -w installed))
ifneq (1,$(NOLPHIN_ALLOW_NON_MINT))
$(error libcinnamon-desktop4t64 (Ubuntu) ist installiert: Paket bitte auf Linux Mint mit libcinnamon-desktop4 bauen)
endif
endif

CONFIGURE_EXTRA_FLAGS = \
	--libexecdir=/usr/lib/$(DEB_HOST_MULTIARCH)/nolphin \
	--buildtype=debugoptimized \
	-D deprecated_warnings=false \
	-D gtk_doc=true \
	-D gtk_layer_shell=true \
	-D selinux=false

export DEB_LDFLAGS_MAINT_APPEND = -Wl,-z,defs -Wl,-O1 -Wl,--as-needed
export DEB_BUILD_MAINT_OPTIONS = hardening=+bindnow
export DPKG_GENSYMBOLS_CHECK_LEVEL = 2

%:
	dh $@ --with gir

override_dh_auto_configure:
	dh_auto_configure -- $(CONFIGURE_EXTRA_FLAGS)

# Bei nur einem Binärpaket installiert debhelper sonst direkt nach
# debian/nolphin; über debian/tmp prüft dh_missing, dass nichts fehlt.
override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp

# Das erzeugte Paket darf keine Entwicklerpakete und keine Ubuntu-eigenen
# Cinnamon-Bibliotheken voraussetzen.
override_dh_gencontrol:
	dh_gencontrol
	sh debian/check-depends debian/nolphin/DEBIAN/control

override_dh_missing:
	dh_missing --fail-missing

# Die Tests brauchen das frisch gebaute GSettings-Schema und eine
# X-Anzeige; sie laufen nur, wenn xvfb-run vorhanden ist. Einige Tests
# hängen von der Umgebung ab (Aufruf als root, 7z installiert), deshalb
# werden Fehlschläge gemeldet, brechen den Paketbau aber nicht ab.
# Mit DEB_BUILD_OPTIONS=nocheck werden sie übersprungen.
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	if command -v xvfb-run >/dev/null 2>&1; then \
		GSETTINGS_SCHEMA_DIR=$(CURDIR)/obj-$(DEB_HOST_GNU_TYPE)/libnolphin-private \
		xvfb-run -a dh_auto_test || echo "WARNUNG: Meson-Tests fehlgeschlagen, siehe testlog.txt"; \
	else \
		echo "xvfb-run fehlt: Tests übersprungen"; \
	fi
endif

# Genau ein Paket: keine separaten -dbg- oder -dbgsym-Pakete
override_dh_strip:
	dh_strip --no-automatic-dbgsym

# Die .gir-Datei wird nicht ausgeliefert; dh_girepository liest sie für
# die Typelib-Abhängigkeiten aus debian/tmp.
override_dh_girepository:
	dh_girepository -l debian/tmp/usr/share/gir-1.0

override_dh_python3:
	dh_python3 -p nolphin /usr/share/nolphin

# workaround for fix lmde4 build
override_dh_dwz:
	# Disabled
	:
